# Preserve the compiler's raw localized /showIncludes prefix so Ninja tracks header dependencies.
if(MSVC AND CMAKE_GENERATOR MATCHES "Ninja")
    set(_dw_probe_dir "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/dw-includes-probe")
    file(MAKE_DIRECTORY "${_dw_probe_dir}")
    set(_dw_probe_header "${_dw_probe_dir}/dw-includes-probe.hpp")
    file(WRITE "${_dw_probe_header}" "// Header dependency probe.\n")
    file(TO_NATIVE_PATH "${_dw_probe_header}" _dw_probe_native_header)
    file(WRITE "${_dw_probe_dir}/probe.cpp" "#include \"${_dw_probe_header}\"\nint dw_include_probe;\n")
    execute_process(
        COMMAND "${CMAKE_CXX_COMPILER}" /nologo /showIncludes /c "${_dw_probe_dir}/probe.cpp" "/Fo${_dw_probe_dir}/probe.obj"
        RESULT_VARIABLE _dw_probe_result OUTPUT_VARIABLE _dw_probe_output ERROR_VARIABLE _dw_probe_error
        ENCODING NONE)
    if(NOT _dw_probe_result EQUAL 0)
        message(FATAL_ERROR "Cannot verify MSVC header dependencies: ${_dw_probe_error}")
    endif()
    string(REPLACE "\r\n" "\n" _dw_probe_output "${_dw_probe_output}")
    string(REPLACE "\n" ";" _dw_probe_lines "${_dw_probe_output}")
    set(_dw_include_prefix "")
    foreach(_dw_line IN LISTS _dw_probe_lines)
        string(FIND "${_dw_line}" "${_dw_probe_native_header}" _dw_path_index)
        if(_dw_path_index LESS 0)
            string(FIND "${_dw_line}" "${_dw_probe_header}" _dw_path_index)
        endif()
        if(_dw_path_index GREATER 0)
            string(SUBSTRING "${_dw_line}" 0 ${_dw_path_index} _dw_include_prefix)
            break()
        endif()
    endforeach()
    if(_dw_include_prefix STREQUAL "")
        message(FATAL_ERROR "MSVC /showIncludes prefix was not recognized; refusing an unsafe incremental build")
    endif()
    set(CMAKE_CL_SHOWINCLUDES_PREFIX "${_dw_include_prefix}")
    set(CMAKE_CXX_CL_SHOWINCLUDES_PREFIX "${_dw_include_prefix}")
endif()
