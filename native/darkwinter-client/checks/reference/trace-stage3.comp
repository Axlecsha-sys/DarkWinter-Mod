#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0,std430) readonly buffer World {uint w[];};
layout(set=0,binding=1,std430) readonly buffer Assets {uint a[];};
layout(set=0,binding=2,rgba8) uniform writeonly image2D outputImage;
layout(set=0,binding=3,std430) writeonly buffer Probe {uvec2 hits[];};
layout(set=0,binding=4,std430) readonly buffer Overlay {uint ui[];};
layout(push_constant) uniform View {vec4 origin;vec4 forward;vec4 right;vec4 up;uvec4 settings;} view;
vec3 av(uint p){return vec3(uintBitsToFloat(a[p]),uintBitsToFloat(a[p+1]),uintBitsToFloat(a[p+2]));}
vec2 au(uint p){return vec2(uintBitsToFloat(a[p]),uintBitsToFloat(a[p+1]));}
bool bounds(vec3 o,vec3 inverseRay,vec3 lo,vec3 hi,float nearLimit,float farLimit){
    vec3 aa=(lo-o)*inverseRay,bb=(hi-o)*inverseRay;
    vec3 mn=min(aa,bb),mx=max(aa,bb);
    return min(farLimit,min(mx.x,min(mx.y,mx.z)))>=max(nearLimit,max(mn.x,max(mn.y,mn.z)));
}
struct Contact {float t;uint triangle;uint shape;ivec3 cell;vec2 bary;};
uint byteOffsets[5]=uint[5](0,512,576,584,585);
bool occupied(uint slot,ivec3 local,int level){
    int n=16>>level;ivec3 p=local>>level;
    uint index=uint(p.x+n*p.z+n*n*p.y),byte=byteOffsets[level]+(index>>3);
    uint value=w[w[9]+slot*147+(byte>>2)];
    return (value&(1u<<((byte&3)*8+(index&7))))!=0;
}
int hash2(int x,int z){uint h=uint(x)*0x1f123bb5u^uint(z)*0x5f356495u;h^=h>>16;h*=0x45d9f3bu;return int(h^(h>>16));}
vec4 texel(uint tri,vec2 uv,ivec3 cell,vec3 p,uint shape,vec3 normal){
    uint tid=a[tri+3],flags=a[tri+7],d=a[1]+shape*8;
    if((flags&3)==1){
        uint tile=uint(hash2(int(floor(float(cell.x)/4)),int(floor(float(cell.z)/4))))&7u;
        vec2 field=abs(normal.y)>.9?p.xz:uv;
        uv=(vec2((cell.x%4+4)%4,(cell.z%4+4)%4)+field)/4;
        if((tile&4u)!=0)uv.x=1-uv.x;
        for(uint i=0;i<(tile&3u);++i)uv=vec2(1-uv.y,uv.x);
    }else if((flags&3)==2){
        uint tile=uint(hash2(cell.x-int(a[d+4]),cell.z-int(a[d+5])))&15u;
        vec2 quadrant=step(vec2(.5),uv);
        if(quadrant!=vec2(1))uv=quadrant*.5+(vec2(tile&3u,tile>>2)+(uv-quadrant*.5)*2)/8;
    }
    uint td=a[4]+tid*4,width=a[td+1],height=a[td+2];
    uvec2 xy=uvec2(clamp(uv,vec2(0),vec2(.999999))*vec2(width,height));
    uint rgba=a[a[5]+a[td]+xy.x+width*xy.y],tint=a[tri+11];
    vec4 c=vec4(rgba&255u,(rgba>>8)&255u,(rgba>>16)&255u,rgba>>24)/255;
    return c*vec4(tint&255u,(tint>>8)&255u,(tint>>16)&255u,tint>>24)/255;
}
bool shapeHit(vec3 o,vec3 ray,vec3 inverseRay,ivec3 cell,uint shape,float nearT,float farT,bool anyHit,inout Contact hit){
    uint d=a[1]+shape*8,node=a[d],end=a[d+1];
    if(node==0xffffffffu)return false;
    bool found=false;vec3 local=o-vec3(cell);
    while(node<end){
        uint n=a[2]+node*12;
        if(!bounds(local,inverseRay,av(n),av(n+4),nearT,min(farT,hit.t+.00005))){node=a[n+8];continue;}
        uint first=a[n+3],count=a[n+7];
        for(uint j=0;j<count;++j){
            uint t=a[3]+(first+j)*24;vec3 p=av(t),e1=av(t+4),e2=av(t+8);
            vec3 q=cross(ray,e2);float det=dot(e1,q);if(abs(det)<1e-9)continue;
            float inv=1/det;vec3 s=local-p;float u=dot(s,q)*inv;if(u<0||u>1)continue;
            vec3 r=cross(s,e1);float v=dot(ray,r)*inv;if(v<0||u+v>1)continue;
            float distance=dot(e2,r)*inv;
            if(distance<max(nearT-0.0002,0.0001)||distance>farT+0.0002||distance>hit.t+.00005)continue;
            if(hit.shape!=0xffffffffu&&abs(distance-hit.t)<=.00005&&a[a[1]+shape*8+3]>=a[a[1]+hit.shape*8+3])continue;
            vec2 uv=au(t+12)+au(t+14)*u+au(t+16)*v;
            if((a[t+7]&8u)!=0&&texel(t,uv,cell,local+ray*distance,shape,av(t+20)).a<.5)continue;
            hit=Contact(distance,t,shape,cell,vec2(u,v));found=true;if(anyHit)return true;
        }
        ++node;
    }
    return found;
}
uint shapeAt(ivec3 cell){
    ivec3 base=ivec3(w[0],w[1],w[2]),dims=ivec3(w[4],w[5],w[6]),sec=ivec3(floor(vec3(cell)/16)),g=sec-base;
    if(any(lessThan(g,ivec3(0)))||any(greaterThanEqual(g,dims)))return 0xffffffffu;
    uint slot=w[w[8]+uint(g.x+dims.x*(g.z+dims.z*g.y))];if(slot==0xffffffffu)return slot;
    ivec3 local=cell-sec*16;return w[w[7]+slot*4096+uint(local.x+16*local.z+256*local.y)];
}
bool trace(vec3 origin,vec3 ray,float maximum,bool occlusion,out Contact hit){
    hit=Contact(maximum,0u,0xffffffffu,ivec3(0),vec2(0));
    vec3 safeRay=vec3(ray.x==0?1e-25:ray.x,ray.y==0?1e-25:ray.y,ray.z==0?1e-25:ray.z),inverseRay=1/safeRay;
    ivec3 base=ivec3(w[0],w[1],w[2]),dims=ivec3(w[4],w[5],w[6]);
    vec3 lo=vec3(base*16),hi=vec3((base+dims)*16);
    vec3 aa=(lo-origin)*inverseRay,bb=(hi-origin)*inverseRay,mn=min(aa,bb),mx=max(aa,bb);
    float t=max(0,max(mn.x,max(mn.y,mn.z))),end=min(maximum,min(mx.x,min(mx.y,mx.z)));
    if(end<t)return false;
    for(uint iteration=0;iteration<view.settings.w&&t<=end;++iteration){
        vec3 p=origin+ray*(t+.00005);ivec3 cell=ivec3(floor(p)),section=ivec3(floor(vec3(cell)/16)),grid=section-base;
        if(any(lessThan(grid,ivec3(0)))||any(greaterThanEqual(grid,dims)))break;
        uint slot=w[w[8]+uint(grid.x+dims.x*(grid.z+dims.z*grid.y))];
        int size=16;
        if(slot!=0xffffffffu){
            ivec3 local=cell-section*16;size=1;
            for(int level=4;level>=0;--level)if(!occupied(slot,local,level)){size=1<<level;break;}
            if(size==1&&occupied(slot,local,0)){
                uint index=uint(local.x+16*local.z+256*local.y);
                uint wordCount=w[12];int radius=int(w[11]),side=2*radius+1;
                vec3 next=(vec3(cell)+step(vec3(0),ray)-origin)*inverseRay;
                float boundary=min(next.x,min(next.y,next.z));bool found=false;
                for(uint m=0u;m<wordCount;++m){uint mask=w[w[10]+(slot*4096+index)*wordCount+m];while(mask!=0u){
                    int b=findLSB(mask)+int(m)*32;mask&=mask-1u;
                    ivec3 owner=cell+ivec3(b%side-radius,b/(side*side)-radius,(b/side)%side-radius);
                    uint shape=shapeAt(owner);
                    if(shape!=0xffffffffu)found=shapeHit(origin,ray,inverseRay,owner,shape,t,min(boundary,end),occlusion,hit)||found;
                    if(occlusion&&found)return true;
                }
                }
                if(found)return true;
            }
        }
        vec3 low=floor(vec3(cell)/size)*size;
        vec3 boundary=low+step(vec3(0),ray)*size;
        vec3 next=(boundary-origin)*inverseRay;
        float advance=min(next.x,min(next.y,next.z));
        t=max(advance,t+.0001);
    }
    return false;
}
void main(){
    uvec2 xy=gl_GlobalInvocationID.xy;
    if(xy.x>=view.settings.y||xy.y>=view.settings.z)return;
    vec4 overlay=vec4(0);
    if(ui[0]!=0u){uvec2 p=xy*uvec2(ui[0],ui[1])/view.settings.yz;uint v=ui[4+p.x+ui[0]*p.y];overlay=vec4(v&255u,(v>>8)&255u,(v>>16)&255u,v>>24)/255;}
    if(overlay.a>.999&&view.settings.x==0u){imageStore(outputImage,ivec2(xy),overlay);return;}
    vec2 screen=(vec2(xy)+.5)/vec2(view.settings.yz)*2-1;screen.y=-screen.y;
    vec3 ray=normalize(view.forward.xyz+view.right.xyz*screen.x*view.forward.w*view.origin.w+view.up.xyz*screen.y*view.origin.w);
    vec3 sky=mix(vec3(.55,.65,.73),vec3(.17,.29,.42),pow(max(ray.y,0),.5));vec3 color=sky;
    Contact hit;bool found=trace(view.origin.xyz,ray,512,false,hit);
    if(found){
        uint t=hit.triangle;vec3 normal=av(t+20);if(dot(normal,ray)>0)normal=-normal;
        vec2 uv=au(t+12)+au(t+14)*hit.bary.x+au(t+16)*hit.bary.y;
        vec3 point=view.origin.xyz+ray*hit.t;
        vec3 albedo=pow(texel(t,uv,hit.cell,point-vec3(hit.cell),hit.shape,normal).rgb,vec3(2.2));
        vec3 sun=normalize(vec3(-.35,.8,-.25));Contact shadow;
        float visibility=dot(normal,sun)<=0?0:trace(point+normal*.003,sun,160,true,shadow)?.12:1;
        float lighting=.38+.16*max(normal.y,0)+.75*max(dot(normal,sun),0)*visibility;
        color=albedo*lighting*vec3(.92,.97,1.03);
        color=mix(color,sky,1-exp(-hit.t*.0035));
    }
    if(view.settings.x!=0)hits[xy.x+view.settings.y*xy.y]=uvec2(found?a[a[1]+hit.shape*8+3]:0xffffffffu,floatBitsToUint(found?hit.t:uintBitsToFloat(0x7f800000u)));
    color=pow(clamp(color/(color*.2+.8),0,1),vec3(1/2.2));
    imageStore(outputImage,ivec2(xy),vec4(mix(color,overlay.rgb,overlay.a),1));
}
