*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Disposable editor / tool files
*.tmp
*.bak
*.swp
*.swo
*~

# Local machine and operator configuration (keep public examples)
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template
/tools/online-node/node-config.json
/tools/online-node/data/
/tools/online-relay/config.local.json

