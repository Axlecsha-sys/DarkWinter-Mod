/tools/codex-auto-continue.ps1
/src/test/java/CodexResumerSetup.java

# Downloaded development binary (the Lab sources and licenses stay tracked)
/tools/darkwinter-lab/cloudflared.exe

# Frontend, Worker and launcher caches
node_modules/
target/
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example
!.dev.vars.*.example

